{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uvx --from git+https://github.com/qazcdesnu/ProjInit@v0.2.0 projinit context",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uvx --from git+https://github.com/qazcdesnu/ProjInit@v0.2.0 projinit check --hook stop",
            "timeout": 180,
            "statusMessage": "검증 검사 실행 중"
          }
        ]
      }
    ]
  }
}
