# Jjabtero 환경 변수 예시. 이 파일을 .env로 복사해 필요한 값만 채운다.
# .env는 Git에 올라가지 않는다. 이미 셸에 있는 환경 변수가 .env보다 우선한다.
# 각 값의 뜻: README.md, docs/design/AppSkeleton.md 2절

# OpenAlex 무료 키(https://openalex.org/settings/api). 없으면 IP마다 나눠 쓰는 하루 예산을 쓴다.
OPENALEX_API_KEY=

# 아래는 보통 비워 둔다. 기본값과 뜻은 README.md에 있다.
# JJABTERO_DB=
# JJABTERO_DATA_DIR=
# JJABTERO_GOOGLE_CLIENT_SECRET=
# JJABTERO_ALLOWED_EMAIL=
# JJABTERO_SESSION_SECRET=
